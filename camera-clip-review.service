[Unit]
Description=Camera Clip Review
After=network.target

[Service]
Type=simple
WorkingDirectory=__INSTALL_DIR__
ExecStart=__INSTALL_DIR__/.venv/bin/python -m app.main
Environment=PYTHONUNBUFFERED=1
User=__SERVICE_USER__

# Restart automatically on a crash, but not after the in-app Shutdown
# button (or `systemctl stop`) - both send SIGTERM, which uvicorn treats
# as a clean exit (code 0), and on-failure only restarts on a non-zero
# exit. Use `always` instead if you want it to come back up even after a
# deliberate shutdown.
Restart=on-failure
RestartSec=5

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
